<?xml version="1.0" encoding="utf-8"?>
<!--
  Discite — English

  To add a translation: copy this file, change `code` and `name` on
  <language>, translate only the text between the tags (never the `key`) and
  save it as <code>.xml in the "locales" folder inside the Discite data folder
  (%APPDATA%\Discite\locales on Windows, ~/Library/Application Support/Discite/locales
  on macOS) or in a "locales" folder next to the executable. The language shows
  up in Settings → Language the next time Discite starts.

  {name} is replaced by a value when the text is shown: keep it.
  <plural>: <one> when the number is 1, <other> otherwise.
-->
